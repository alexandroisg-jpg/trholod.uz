{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trholod-uz",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "run_worker_first": false,
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trholod-db",
      "database_id": "c891abfa-98a4-4f6d-8a13-c10a598a80a6",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {},
  "account_id": "2dc12cf7064c0d22f83117327e8c4660",
  "routes": [
    {
      "pattern": "trholod.uz",
      "custom_domain": true
    },
    {
      "pattern": "www.trholod.uz",
      "custom_domain": true
    }
  ]
}
